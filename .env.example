# OliveYoung Stock Checker environment template
# 실제 값은 GitHub Secrets 또는 Vercel Environment Variables에 저장한다.
# 이 파일에는 비밀값을 넣지 않는다.

# === OliveYoung curator auth ===
# refresh-oy-cookie.mjs (로컬 HIL 로그인) — 저장소에 커밋하지 말 것
OY_USERNAME=
OY_PASSWORD=
OY_REFRESH_COOKIE=
OY_CURATOR_COOKIE=
OY_SESSION_ID=
OY_LINKAGE_STRING=
OY_LINKAGE_JWT=
OLIVEYOUNG_LINKAGE_STRING=
OLIVEYOUNG_LINKAGE_JWT=
OLIVEYOUNG_AFFILIATE_REGISTER_ID=

# === Vercel automation ===
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DEPLOY_HOOK=
VERCEL_ENV_TARGETS=production
SKIP_VERCEL_DEPLOY_HOOK=1

# === Alert email ===
ALERT_EMAIL_FROM=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=

# === GitHub / favorites sync ===
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# === Google Cloud Run deploy ===
GCP_PROJECT_ID=
GCP_SA_KEY=

# === Kakao ===
KAKAO_REST_KEY=

# Vercel Cron/Blob for hot-item sales/revenue estimation
# Create a Vercel Blob store connected to the project so BLOB_READ_WRITE_TOKEN is injected.
BLOB_READ_WRITE_TOKEN=
# Optional but recommended: Vercel sends this as Authorization: Bearer <secret> for cron calls.
CRON_SECRET=

# === Multi-user price alerts (Vercel + Cloud Run) ===
# 32 random bytes encoded as base64. Encrypts every device, push subscription,
# target price, and notification-outbox record before it reaches Vercel Blob.
PRICE_ALERT_DATA_KEY=
# Optional storage isolation override. Defaults to VERCEL_ENV (production/preview/development).
PRICE_ALERT_STORE_NAMESPACE=
# Separate random service credential shared only by Vercel cron and Cloud Run.
PRICE_ALERT_SERVICE_SECRET=
PRICE_ALERT_PRICE_API_URL=https://oy-stock-api-3596046881.asia-northeast3.run.app/api/prices
PRICE_ALERT_UPSTREAM_TIMEOUT_MS=190000
PRICE_ALERT_VAPID_SUBJECT=https://olivestock.co.kr
PRICE_ALERT_VAPID_PUBLIC_KEY=
PRICE_ALERT_VAPID_PRIVATE_KEY=
# Vercel Blob abuse/capacity controls. Defaults are shown.
PRICE_ALERT_CREATE_LIMIT=8
PRICE_ALERT_CREATE_WINDOW_SECONDS=3600
PRICE_ALERT_MUTATION_LIMIT=120
PRICE_ALERT_MUTATION_WINDOW_SECONDS=3600
PRICE_ALERT_MAX_REGISTERED_DEVICES=5000
# Conservative bound: 20 devices x 10 alerts, with same-goods options deduplicated.
PRICE_ALERT_MAX_ACTIVE_DEVICES=20
PRICE_ALERT_INACTIVE_TTL_DAYS=30
PRICE_ALERT_MAINTENANCE_MAX_PER_RUN=100
PRICE_ALERT_TOMBSTONE_TTL_HOURS=24

# Optional Cloud Run load controls. Code defaults are shown.
OY_SEARCH_MAX_CONCURRENT=2
OY_SEARCH_QUEUE_MAX=12
OY_SEARCH_QUEUE_WAIT_MS=5000
PRICE_LOOKUP_CONCURRENCY=1
PRICE_LOOKUP_PACE_MS=1000
PRICE_LOOKUP_WINDOW_MAX=20
PRICE_LOOKUP_WINDOW_MS=60000
PRICE_LOOKUP_TOTAL_TIMEOUT_MS=180000
PRICE_CACHE_TTL_MS=300000

# === Price-alert 30-day pass (PortOne V2 / KakaoPay) ===
# Fail-closed switch. There is no subscription or automatic renewal.
PRICE_ALERT_ENTITLEMENT_ENABLED=false
PRICE_ALERT_PORTONE_STORE_ID=
PRICE_ALERT_PORTONE_CHANNEL_KEY=
PRICE_ALERT_PORTONE_API_SECRET=
PRICE_ALERT_PORTONE_EXPECTED_CHANNEL_TYPE=LIVE
PRICE_ALERT_PORTONE_TIMEOUT_MS=65000
PRICE_ALERT_PUBLIC_SITE_URL=https://olivestock.co.kr
# Lifetime promotion code: store only HMAC-SHA256(code, pepper), hex or base64url.
PRICE_ALERT_PROMO_CODE_DIGEST=
PRICE_ALERT_PROMO_CODE_PEPPER=
# Optional independent abuse limits.
PRICE_ALERT_PAYMENT_CREATE_LIMIT=5
PRICE_ALERT_PAYMENT_CREATE_WINDOW_SECONDS=3600
PRICE_ALERT_PAYMENT_COMPLETE_LIMIT=30
PRICE_ALERT_PAYMENT_COMPLETE_WINDOW_SECONDS=3600
PRICE_ALERT_PAYMENT_WEBHOOK_LIMIT=600
PRICE_ALERT_PAYMENT_WEBHOOK_WINDOW_SECONDS=3600
PRICE_ALERT_PROMOTION_LIMIT=10
PRICE_ALERT_PROMOTION_WINDOW_SECONDS=3600
# KST busy windows use 30-minute collection by default; other hours collect hourly at minute 00.
HOT_RANK_BUSY_WINDOWS_KST=10-14,18-24
# Cost controls for adaptive collection.
HOT_RANK_BUSY_INTERVAL_MINUTES=30
HOT_RANK_QUIET_INTERVAL_MINUTES=60
HOT_RANK_PRIORITY_SALES_LIMIT=20
HOT_RANK_PRIORITY_REVENUE_LIMIT=20
HOT_RANK_RETRY_PER_RUN_LIMIT=12
HOT_RANK_OUT_OF_TOP_PER_RUN_LIMIT=10
# Legacy non-adaptive fallback limits. TOP100 ranking is fetched every run;
# stock is collected in rotating slices to avoid timeouts/rate blocks.
HOT_RANK_BUSY_STOCK_LIMIT=25
HOT_RANK_QUIET_STOCK_LIMIT=25
HOT_RANK_STOCK_TIMEOUT_MS=15000
# Keep enough observations for 1일/7일/30일 그래프.
HOT_RANK_HISTORY_DAYS=35
HOT_RANK_RUN_HISTORY_DAYS=30

# === Local app ===
PUBLIC_APP_URL=http://localhost:3000

# === Optional: cookie refresh script ===
# SLACK_WEBHOOK_URL=
# LANDING_PROXY_CHECK_URL=https://oy-stock.vercel.app/api/oliveyoung/landing-proxy?check=1

