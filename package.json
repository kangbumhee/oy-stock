{
  "name": "oliveyoung-stock-checker",
  "version": "8.0.0",
  "private": true,
  "scripts": {
    "start": "node server/server.mjs",
    "gcp-build": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium",
    "setup:oy-cookie-profile": "node scripts/refresh-oy-cookie-from-profile.mjs --setup",
    "refresh:oy-cookie:chrome": "node scripts/refresh-oy-cookie-from-profile.mjs",
    "setup:oy-login-secrets": "powershell.exe -NoProfile -File scripts/oy-login-secrets.ps1 -Action Setup",
    "status:oy-login-secrets": "powershell.exe -NoProfile -File scripts/oy-login-secrets.ps1 -Action Status",
    "install:oy-login-task": "powershell.exe -NoProfile -File scripts/install-oy-cookie-refresh-task.ps1",
    "check:oy-login": "node scripts/check-oy-login.mjs",
    "test:oy-login": "node --test --test-concurrency=1 tests/oy-*.test.js",
    "test:affiliate-link": "node --test tests/affiliate-link.test.js",
    "test:price-alerts": "node --test tests/price-alerts*.test.js",
    "test:server": "node --test server/*.test.mjs",
    "test:hidden-stock": "node --test tests/hidden-stock*.test.js tests/hidden-stock-collector.test.mjs server/hidden-*.test.mjs",
    "backfill:hidden-stock": "node scripts/backfill-hidden-stock.mjs",
    "collect:hidden-stock": "node scripts/collect-hidden-stock.mjs",
    "status:hidden-stock": "node scripts/collect-hidden-stock.mjs --status",
    "build:blog": "node scripts/build-blog-pages.js",
    "build:blog:daily": "node scripts/build-blog-pages.js --daily --limit 1 --scan-limit 100",
    "build:blog:assets": "node scripts/render-blog-product-assets.js",
    "verify:blog:manual": "node scripts/verify-manual-review-post.js",
    "submit:indexnow": "node scripts/submit-indexnow.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "nodemailer": "^9.0.5",
    "playwright": "^1.50.0",
    "web-push": "^3.6.7"
  }
}
