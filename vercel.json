{
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "proxy": {
    "entrypoint": "site-access-proxy.ts"
  },
  "outputDirectory": "public",
  "functions": {
    "api/oliveyoung/search.js": { "maxDuration": 60 },
    "api/oliveyoung/inventory.js": { "maxDuration": 60 },
    "api/oliveyoung/hidden-stock.js": { "maxDuration": 60 },
    "api/oliveyoung/hot-ranking-cron.js": { "maxDuration": 800 },
    "api/oliveyoung/curator-redirect.js": { "maxDuration": 60 },
    "api/price-alerts/account.js": { "maxDuration": 60 },
    "api/price-alerts/admin.js": { "maxDuration": 60 },
    "api/price-alerts/hourly.js": { "maxDuration": 800 },
    "api/ph-guide.js": { "maxDuration": 120 },
    "api/**/*.js": { "excludeFiles": "{public/images,public/blog,tests,scripts,server,reports}/**" }
  },
  "crons": [
    {
      "path": "/api/oliveyoung/hot-ranking-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/price-alerts/hourly",
      "schedule": "7 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/|js/|css/|data/|sw\\.js|site\\.webmanifest).*)",
      "has": [{ "type": "host", "value": "www.olivestock.co.kr" }],
      "destination": "https://olivestock.co.kr/:path",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/data/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/game/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/guide", "destination": "/guide/index.html" },
    { "source": "/guide/:slug", "destination": "/guide/:slug/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/game", "destination": "/game/index.html" },
    { "source": "/site-map", "destination": "/site-map.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/price-alerts/payment/create", "destination": "/api/price-alerts/payment-create" },
    { "source": "/api/price-alerts/payment/complete", "destination": "/api/price-alerts/payment-complete" },
    { "source": "/api/price-alerts/payment/webhook", "destination": "/api/price-alerts/payment-webhook" },
    { "source": "/api/proxy:tail(.*)", "destination": "/api/proxy" }
  ]
}
